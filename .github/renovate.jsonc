{
  // NOTE: This should be able to catch github-actions and dockerfile!

  // Overall Renovate config
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>AnarchoBooleanism/renovate-config#v7.0.0"
  ],
  "ignorePaths": [
    "compose.example.yaml"
  ],
  "packageRules": [
    {
      "matchFileNames": ["api-server/.python-version"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15.0" // 3.15 currently has a few too many issues, wait
    }
  ]
}
